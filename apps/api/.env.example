# Template environment for the Disney World Tracker API.
#
# Copy this file to apps/api/.env (which is gitignored) and edit the values
# for your local setup. The defaults below match the credentials in the
# root docker-compose.yml so a fresh clone runs end-to-end without changes.
#
#   cp apps/api/.env.example apps/api/.env
#
# loadConfig() (apps/api/src/config.ts) reads these values at startup. Any
# missing required variable fails fast with a single readable error.

# Runtime environment. One of: development | test | production.
NODE_ENV=development

# Where the Fastify server listens.
HOST=0.0.0.0
PORT=3000

# pino log level. One of: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# PostgreSQL connection string. Matches the docker-compose `postgres` service.
DATABASE_URL=postgres://dwt:dwt@localhost:5432/dwt

# Redis connection string. Matches the docker-compose `redis` service.
REDIS_URL=redis://localhost:6379

# Session token signing secret. Must be at least 32 characters. Generate a
# real value for any non-local deployment with: openssl rand -base64 32
SESSION_SECRET=local-dev-session-secret-change-in-production-please

# Upstream catalog source. Defaults to the public ThemeParks.wiki v1 API.
# Override only when running against a fixture server in tests.
THEMEPARKS_BASE_URL=https://api.themeparks.wiki/v1

# Disney Sync Gateway base URL. Optional: defaults to the documented public
# endpoint below when unset. Must be a well-formed absolute URL. Override only
# when running against a fixture server in tests.
DISNEY_SYNC_GATEWAY_BASE_URL=https://realtime-sync-gw.wdprapps.disney.com/park-platform-pub/

# Public dining-menu API the anonymous Disney website itself calls
# (`?searchTerm={facilityId|slug}`). Demand-driven menus are sourced here
# because it serves anonymous callers (the scoped explorer-service finder
# requires a guest token the app does not have). Optional: defaults below.
DISNEY_DINING_MENU_BASE_URL=https://disneyworld.disney.go.com/dining/dinemenu/api/menu

# Static credentials for HTTP Basic auth against the Disney Sync Gateway. Both
# are required and must be non-empty; startup fails fast if either is missing.
DISNEY_SYNC_GATEWAY_USERNAME=change-me
DISNEY_SYNC_GATEWAY_PASSWORD=change-me

# --- Disney resilience tuning (all optional; sane defaults shown) ----------
# Only the credentials above are strictly required. The values below control
# the shared Request_Budget, Backoff_Policy, and freshness intervals; override
# only if you have a reason to.

# Shared outbound Request_Budget the Rate_Limiter enforces across all processes.
DISNEY_MAX_RPS=5
DISNEY_MAX_CONCURRENCY=4

# Backoff_Policy for retriable Disney failures (exponential + jitter, bounded).
DISNEY_BACKOFF_BASE_MS=500
DISNEY_BACKOFF_FACTOR=2
DISNEY_BACKOFF_MAX_RETRIES=5
DISNEY_BACKOFF_MAX_DELAY_MS=30000
DISNEY_BACKOFF_MAX_TOTAL_MS=120000

# How long a cached restaurant menu is served before a lazy Menu_Service fetch.
MENU_FRESHNESS_MS=86400000

# Infrequent static-sync cadence. Must be at least 24h (86400000ms).
CATALOG_SYNC_INTERVAL_MS=86400000

# Shared secret gating the internal sampling cron (POST/HEAD /internal/sampling/run).
SAMPLING_CRON_SECRET=change-me

# Shared secret gating the internal Pin reconciliation cron
# (POST/HEAD /internal/pins/reconcile). A dedicated secret, not the same
# value as SAMPLING_CRON_SECRET.
PIN_RECONCILE_CRON_SECRET=change-me

# Shared secret gating the internal Trip Booking reminders cron
# (POST/HEAD /internal/trip-booking-reminders/run). A dedicated secret, not the same
# value as SAMPLING_CRON_SECRET or PIN_RECONCILE_CRON_SECRET.
TRIP_BOOKING_CRON_SECRET=change-me

# Trip Booking Reminders tuning (all optional; defaults shown)
# BOOKING_REMINDER_LEADS=eve,open
# BOOKING_REMINDER_CATCHUP_MINUTES=180
# BOOKING_REMINDER_MIN_PASS_INTERVAL_SECONDS=300
# BOOKING_REMINDER_SEND_START=06:00
# BOOKING_REMINDER_SEND_END=23:00
# BOOKING_REMINDER_RETENTION_DAYS=30

# HTTP Basic credentials gating the internal operator Admin Panel (/admin/*).
ADMIN_PANEL_USERNAME=change-me
ADMIN_PANEL_PASSWORD=change-me

# Transactional email delivery.
# Supports either Resend REST API or standard SMTP (e.g. Gmail without custom domain).
# When RESEND_API_KEY is provided, dispatches via Resend.
# When SMTP credentials are provided, dispatches via SMTP.
# When neither is configured, the API operates in mock mode and logs the 6-digit
# verification code and reset URL directly to the server log.
RESEND_API_KEY=

# SMTP credentials (useful for sending via Gmail App Passwords without a domain):
# For Gmail: set SMTP_SERVICE=gmail or SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=youremail@gmail.com, SMTP_PASS=16-digit-google-app-password
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender address. Defaults to SMTP_USER if set, otherwise auth@disneytracker.app:
MAIL_FROM="Disney World Tracker <auth@disneytracker.app>"
