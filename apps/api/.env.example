# Template environment for the Disney World Tracker API.
#
# Copy this file to apps/api/.env (which is gitignored) and edit the values
# for your local setup. The defaults below match the credentials in the
# root docker-compose.yml so a fresh clone runs end-to-end without changes.
#
#   cp apps/api/.env.example apps/api/.env
#
# loadConfig() (apps/api/src/config.ts) reads these values at startup. Any
# missing required variable fails fast with a single readable error.

# Runtime environment. One of: development | test | production.
NODE_ENV=development

# Where the Fastify server listens.
HOST=0.0.0.0
PORT=3000

# pino log level. One of: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# PostgreSQL connection string. Matches the docker-compose `postgres` service.
DATABASE_URL=postgres://dwt:dwt@localhost:5432/dwt

# Redis connection string. Matches the docker-compose `redis` service.
REDIS_URL=redis://localhost:6379

# S3-compatible object store for avatar uploads. Matches the docker-compose
# `minio` service. The bucket is auto-created by the `minio-init` job.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=dwt-minio-admin
S3_SECRET_ACCESS_KEY=dwt-minio-password

# Session token signing secret. Must be at least 32 characters. Generate a
# real value for any non-local deployment with: openssl rand -base64 32
SESSION_SECRET=local-dev-session-secret-change-in-production-please

# Upstream catalog source. Defaults to the public ThemeParks.wiki v1 API.
# Override only when running against a fixture server in tests.
THEMEPARKS_BASE_URL=https://api.themeparks.wiki/v1
