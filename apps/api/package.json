{
  "name": "@dwt/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API for Disney World Tracker.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:cloud": "tsx watch --env-file=.env.dev src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "migrate:cloud": "tsx --env-file=.env.dev src/db/migrate.ts",
    "build-bridge": "tsx --env-file=.env src/scripts/buildBridge.ts",
    "build-bridge:cloud": "tsx --env-file=.env.dev src/scripts/buildBridge.ts",
    "sync": "tsx --env-file=.env src/scripts/runSync.ts",
    "sync:cloud": "tsx --env-file=.env.dev src/scripts/runSync.ts",
    "backfill-facets": "tsx --env-file=.env src/scripts/backfillFacetEnrichment.ts",
    "backfill-facets:cloud": "tsx --env-file=.env.dev src/scripts/backfillFacetEnrichment.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@dwt/shared": "0.0.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "argon2": "^0.40.0",
    "bullmq": "^5.13.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^9.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "fast-check": "^3.21.0",
    "ioredis-mock": "^8.13.1",
    "pg-mem": "^3.0.14",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
