# Mobile app environment template.
# Copy this file to `.env.local` (gitignored) for local development:
#   Windows:  copy .env.example .env.local
#   macOS/*nix: cp .env.example .env.local
#
# Expo's CLI loads `.env.local` automatically at startup, and
# app.config.ts reads API_BASE_URL into extra.apiBaseUrl. When unset,
# app.config.ts falls back to http://localhost:3000.

# Base URL of the Fastify API the app should talk to.
#   Android emulator:  http://10.0.2.2:3000   (10.0.2.2 = host machine)
#   iOS simulator:     http://localhost:3000
#   Physical phone:    http://<your-LAN-IP>:3000  (e.g. http://192.168.1.50:3000)
API_BASE_URL=http://10.0.2.2:3000
