{
  "name": "disney-world-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Disney World Tracker monorepo: Fastify API, React Native mobile app, and shared TypeScript package.",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:api:cloud": "npm run dev:cloud --workspace apps/api",
    "dev:mobile": "npm run dev --workspace apps/mobile",
    "build:shared": "npm run build --workspace packages/shared",
    "migrate": "npm run migrate --workspace apps/api",
    "migrate:cloud": "npm run migrate:cloud --workspace apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "@types/react": "19.2.10"
  }
}
